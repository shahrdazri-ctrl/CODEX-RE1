    </table:table-row>
    <table:table-row table:style-name="ro2">
     <table:table-cell office:value-type="float" office:value="449" calcext:value-type="float">
      <text:p>449</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>hideout</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce59" office:value-type="string" calcext:value-type="string">
      <text:p>Entre aqui para trocar para *BMX* ou mudar o *estilo* da sua BMX.</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>shown when the BMX garage door opens</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="1020"/>
    </table:table-row>
    <table:table-row table:style-name="ro2">
     <table:table-cell office:value-type="float" office:value="450" calcext:value-type="float">
      <text:p>450</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>hideout</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce59" office:value-type="string" calcext:value-type="string">
      <text:p>Entre aqui para trocar para *patins* ou mudar o estilo dos seus patins.</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>shown when the skates garage door opens</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="1020"/>
    </table:table-row>
    <table:table-row table:style-name="ro2">
     <table:table-cell office:value-type="float" office:value="451" calcext:value-type="float">
      <text:p>451</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>hideout</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce59" office:value-type="string" calcext:value-type="string">
      <text:p>Entre aqui para trocar para *skate* ou mudar o estilo do seu skate.</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
