     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>hideout</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce75" office:value-type="string" calcext:value-type="string"><text:p><text:span text:style-name="T1">Cuando estés listo, iremos a *Versum Hill</text:span>*, y ya seguiremos desde allí.</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="1021"/>
