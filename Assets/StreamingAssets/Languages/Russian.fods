    <table:table-row table:style-name="ro2">
     <table:table-cell table:style-name="ce104" office:value-type="string" calcext:value-type="string">
      <text:p>Example localization</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce104" office:value-type="string" calcext:value-type="string">
      <text:p>Representation in-game</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce104" office:value-type="string" calcext:value-type="string">
