    </table:table-row>
    <table:table-row table:style-name="ro2">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>Hello, {.}</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>Hello, ‘name’</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>Where ‘name’ is the parameter textToInsert used in SetLocalizationOnText (and similar functions)</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="ro2">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>Press [boost_button] to continue</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>Press ‘boost button glyph’ to continue</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>Where boost ‘button glyph’ is an icon corresponding to the correct controller button</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="ro6">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>Hello, *.*</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string"><text:p>Hello, ‘<text:span text:style-name="T1">name</text:span><text:span text:style-name="T2">’</text:span></text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string"><text:p/><text:p>              Where ‘</text:p><text:p>              name</text:p><text:p>              ’ is the parameter textToInsert used in SetLocalizationOnText (and similar functions)</text:p><text:p/><text:p/><text:p/><text:p/><text:p/><text:p/><text:p>            </text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="ro2">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>Hello, *Person*</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string"><text:p>Hello, <text:span text:style-name="T1">Person</text:span></text:p>
     </table:table-cell>
     <table:table-cell/>
    </table:table-row>
    <table:table-row table:style-name="ro7">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>Press [boost_button] to {.}</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>Press ‘boost button glyph’ to ‘continue’</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string"><text:p/><text:p>              W<text:span text:style-name="T7">here boost ‘button glyph’ is an icon corresponding to the correct controller button.</text:span></text:p><text:p/><text:p/><text:p/><text:p/><text:p/><text:p/><text:p>            </text:p><text:p/><text:p>              Where ‘continue’ is inserted as the textToInsert parameter in functions like SetLocalizationOnText.</text:p><text:p/><text:p/><text:p/><text:p/><text:p/><text:p/><text:p>            </text:p>
     </table:table-cell>
    </table:table-row>
