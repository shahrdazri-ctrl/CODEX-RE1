     <table:table-cell office:value-type="float" office:value="30" calcext:value-type="float">
      <text:p>30</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>Mall</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>Пока-пока.</text:p>
     </table:table-cell>
