    <table:table-row table:style-name="ro2">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>EMAIL_CH3_SHINE_05_P2_MSG</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>Нашла новое место, довольно уединенное :)</text:p>
