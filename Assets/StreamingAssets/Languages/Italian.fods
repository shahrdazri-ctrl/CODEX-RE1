     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string"><text:p/><text:p>              Where ‘</text:p><text:p>              name</text:p><text:p>              ’ is the parameter textToInsert used in SetLocalizationOnText (and similar functions)</text:p><text:p/><text:p/><text:p/><text:p/><text:p/><text:p/><text:p>            </text:p>
     </table:table-cell>
    </table:table-row>
