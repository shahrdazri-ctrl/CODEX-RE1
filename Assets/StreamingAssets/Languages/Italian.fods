      <text:p>EMAIL_CH5_BEL_01_P1_MSG</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>Ehiii:D ti ho appena visto passare</text:p>
     </table:table-cell>
