     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>hideout</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce80" office:value-type="string" calcext:value-type="string"><text:p><text:span text:style-name="T1">Zonder een lichaam werd het steeds zwakker en *raakte z’n herinneringen</text:span> kwijt*, wegrottend.</text:p>
