     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>Where ‘name’ is the parameter textToInsert used in SetLocalizationOnText (and similar functions)</text:p>
     </table:table-cell>
    </table:table-row>
