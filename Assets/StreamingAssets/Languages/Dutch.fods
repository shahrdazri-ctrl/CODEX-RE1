     </table:table-cell>
     <table:table-cell table:style-name="ce80" office:value-type="string" calcext:value-type="string">
      <text:p>We hadden een confrontatie met de verdachten, maar ze slaagden erin ons terug te dringen.</text:p>
     </table:table-cell>
