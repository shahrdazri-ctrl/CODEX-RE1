     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>osaka</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce80" office:value-type="string" calcext:value-type="string"><text:p><text:span text:style-name="T1">*In dit </text:span>standbeeld zit een afsnijroute*. Ik geloof dat er een *handige manier* is om deze open te krijgen.</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
