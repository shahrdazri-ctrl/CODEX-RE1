    <table:table-row table:style-name="ro2">
     <table:table-cell table:style-name="ce106" office:value-type="string" calcext:value-type="string"><text:p><text:span text:style-name="T4">EMAIL_CH5_COIL</text:span>_01_P1_MSG</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>Ik ben het, Coil. Weet je nog?</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="ro2">
     <table:table-cell office:value-type="string" calcext:value-type="string"><text:p><text:span text:style-name="T4">EMAIL_CH5_COIL</text:span>_01_P2_MSG</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
