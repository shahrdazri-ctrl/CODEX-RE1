     <table:table-cell table:style-name="ce80"/>
     <table:table-cell table:number-columns-repeated="1021"/>
    </table:table-row>
    <table:table-row table:style-name="ro2">
     <table:table-cell office:value-type="float" office:value="47" calcext:value-type="float">
      <text:p>47</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>downhill</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce80" office:value-type="string" calcext:value-type="string">
      <text:p>Arresteer die vandalen!</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>the police</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="1020"/>
    </table:table-row>
    <table:table-row table:style-name="ro2">
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce80"/>
     <table:table-cell table:number-columns-repeated="1021"/>
    </table:table-row>
    <table:table-row table:style-name="ro2">
     <table:table-cell office:value-type="float" office:value="48" calcext:value-type="float">
      <text:p>48</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>downhill</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce80" office:value-type="string" calcext:value-type="string">
      <text:p>Heb je biz in onze schuilplaats? Denk het niet...</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>frank guarding the barricade to their hideout</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="1020"/>
    </table:table-row>
    <table:table-row table:style-name="ro2">
     <table:table-cell office:value-type="float" office:value="49" calcext:value-type="float">
      <text:p>49</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>downhill</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce80" office:value-type="string" calcext:value-type="string">
      <text:p>Je hebt geen *70 REP* - ik praat niet tegen je.</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="1021"/>
    </table:table-row>
    <table:table-row table:style-name="ro2">
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce80"/>
     <table:table-cell table:number-columns-repeated="1021"/>
    </table:table-row>
    <table:table-row table:style-name="ro2">
     <table:table-cell office:value-type="float" office:value="50" calcext:value-type="float">
      <text:p>50</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>downhill</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce80" office:value-type="string" calcext:value-type="string">
      <text:p>Kijk eens aans, daar heb je Tryce en zijn crew.</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>prince talking</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="1020"/>
    </table:table-row>
    <table:table-row table:style-name="ro2">
     <table:table-cell office:value-type="float" office:value="51" calcext:value-type="float">
      <text:p>51</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>downhill</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce80" office:value-type="string" calcext:value-type="string">
      <text:p>Ze noemen mij de *Flesh Prince*.</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="1021"/>
    </table:table-row>
    <table:table-row table:style-name="ro2">
     <table:table-cell office:value-type="float" office:value="52" calcext:value-type="float">
      <text:p>52</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>downhill</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce80" office:value-type="string" calcext:value-type="string">
      <text:p>Welkom in mijn domein.</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="1021"/>
    </table:table-row>
    <table:table-row table:style-name="ro2">
     <table:table-cell office:value-type="float" office:value="53" calcext:value-type="float">
      <text:p>53</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>downhill</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce80" office:value-type="string" calcext:value-type="string">
      <text:p>Let niet op de jongens. Ze moeten zich toch vermaken, of niet soms?</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="1021"/>
    </table:table-row>
    <table:table-row table:style-name="ro2">
     <table:table-cell office:value-type="float" office:value="54" calcext:value-type="float">
      <text:p>54</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>downhill</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce80" office:value-type="string" calcext:value-type="string">
      <text:p>Prince is een wonderkind als het gaat om alle dingen van vlees en metaal.</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>tryce</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="1020"/>
    </table:table-row>
    <table:table-row table:style-name="ro2">
     <table:table-cell office:value-type="float" office:value="55" calcext:value-type="float">
      <text:p>55</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>downhill</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce80" office:value-type="string" calcext:value-type="string">
      <text:p>Hij heeft al deze kerels gebouwd.</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="1021"/>
    </table:table-row>
    <table:table-row table:style-name="ro2">
     <table:table-cell office:value-type="float" office:value="56" calcext:value-type="float">
      <text:p>56</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>downhill</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce80" office:value-type="string" calcext:value-type="string">
      <text:p>Ik ben de beste die er is.</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>prince talking</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="1020"/>
    </table:table-row>
    <table:table-row table:style-name="ro2">
     <table:table-cell office:value-type="float" office:value="57" calcext:value-type="float">
      <text:p>57</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>downhill</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce80" office:value-type="string" calcext:value-type="string">
      <text:p>Wanneer iemand zijn arm verliest, komen ze naar me toe.</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="1021"/>
    </table:table-row>
    <table:table-row table:style-name="ro2">
     <table:table-cell office:value-type="float" office:value="58" calcext:value-type="float">
      <text:p>58</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>downhill</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce80" office:value-type="string" calcext:value-type="string">
      <text:p>Of in zeldzame gevallen...</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="1021"/>
    </table:table-row>
    <table:table-row table:style-name="ro2">
     <table:table-cell office:value-type="float" office:value="59" calcext:value-type="float">
      <text:p>59</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>downhill</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce80" office:value-type="string" calcext:value-type="string">
      <text:p>... als ze hun *hoofd* verloren zijn.</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="1021"/>
    </table:table-row>
    <table:table-row table:style-name="ro2">
     <table:table-cell office:value-type="float" office:value="60" calcext:value-type="float">
      <text:p>60</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>downhill</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce80" office:value-type="string" calcext:value-type="string">
      <text:p>Dus... jij was diegene die Red zijn cyberhead gaf?</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>bel</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="1020"/>
    </table:table-row>
    <table:table-row table:style-name="ro2">
     <table:table-cell office:value-type="float" office:value="61" calcext:value-type="float">
      <text:p>61</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>downhill</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce80" office:value-type="string" calcext:value-type="string">
      <text:p>Dus... je bent soort van mijn vader?</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>red</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="1020"/>
    </table:table-row>
    <table:table-row table:style-name="ro2">
     <table:table-cell office:value-type="float" office:value="62" calcext:value-type="float">
