     <table:table-cell table:style-name="ce80" office:value-type="string" calcext:value-type="string"><text:p><text:span text:style-name="T1">Ik herinner me Teun</text:span> nog wel. *Zijn vader was een goede officier*....</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>berlage</text:p>
