      <text:p>137</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>osaka</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce64" office:value-type="string" calcext:value-type="string">
      <text:p>Faux ne s&apos;est pas rendu compte qu&apos;il y avait un *témoin clé* qui avait tout vu.</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>dj (present)</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="1020"/>
