     <table:table-cell table:style-name="ce64"/>
     <table:table-cell table:number-columns-repeated="1021"/>
    </table:table-row>
    <table:table-row table:style-name="ro2">
     <table:table-cell office:value-type="float" office:value="330" calcext:value-type="float">
      <text:p>330</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>osaka</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce64" office:value-type="string" calcext:value-type="string">
      <text:p>Je croyais que DJ voulait aider Félix...</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>solace later on</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="1020"/>
    </table:table-row>
    <table:table-row table:style-name="ro2">
     <table:table-cell office:value-type="float" office:value="331" calcext:value-type="float">
      <text:p>331</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>osaka</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce64" office:value-type="string" calcext:value-type="string">
      <text:p>Alors, pourquoi FUTURISM nous met des bâtons dans les roues ?</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="1021"/>
    </table:table-row>
    <table:table-row table:style-name="ro2">
     <table:table-cell office:value-type="float" office:value="332" calcext:value-type="float">
      <text:p>332</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>osaka</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce64" office:value-type="string" calcext:value-type="string">
      <text:p>... Je ne comprends vraiment pas. Pourquoi tout le monde n&apos;est pas gentil avec tout le monde ?</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="1021"/>
    </table:table-row>
    <table:table-row table:style-name="ro2">
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce64"/>
     <table:table-cell table:number-columns-repeated="1021"/>
    </table:table-row>
    <table:table-row table:style-name="ro2">
     <table:table-cell office:value-type="float" office:value="333" calcext:value-type="float">
      <text:p>333</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>osaka</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce64" office:value-type="string" calcext:value-type="string">
      <text:p>Hé, Félix... Je croyais que DJ voulait t&apos;aider...</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>solace later on when to talked to with red</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="1020"/>
    </table:table-row>
    <table:table-row table:style-name="ro2">
     <table:table-cell office:value-type="float" office:value="334" calcext:value-type="float">
      <text:p>334</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>osaka</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce64" office:value-type="string" calcext:value-type="string">
      <text:p>Alors, pourquoi FUTURISM nous met des bâtons dans les roues ?</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="1021"/>
    </table:table-row>
    <table:table-row table:style-name="ro2">
     <table:table-cell office:value-type="float" office:value="335" calcext:value-type="float">
      <text:p>335</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>osaka</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce64" office:value-type="string" calcext:value-type="string">
      <text:p>... Je ne comprends vraiment pas. Pourquoi tout le monde n&apos;est pas gentil avec tout le monde ?</text:p>
