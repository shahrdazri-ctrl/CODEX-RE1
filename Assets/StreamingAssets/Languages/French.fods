     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>osaka</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce64" office:value-type="string" calcext:value-type="string">
      <text:p>Félix... ?! Qu-qu&apos;est-ce qui lui est arrivé ?!</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>dj (past)</text:p>
     </table:table-cell>
