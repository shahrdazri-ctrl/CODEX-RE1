     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>hideout</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce64" office:value-type="string" calcext:value-type="string"><text:p><text:span text:style-name="T1">Je t&apos;ai ajouté les applis *Caméra* et *Photos</text:span>* !</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="1021"/>
