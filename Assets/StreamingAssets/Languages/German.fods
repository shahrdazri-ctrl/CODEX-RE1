     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>downhill</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>Der Typ weiß nicht einmal, wo sein Kopf ist...</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>one of the FRANKS</text:p>
