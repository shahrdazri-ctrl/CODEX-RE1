     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>O09</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>Tu es.</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>Player is in another dream, so the objective is self evident</text:p>
