      <text:p>167</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>hideout</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>Ich werde es tun.</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
