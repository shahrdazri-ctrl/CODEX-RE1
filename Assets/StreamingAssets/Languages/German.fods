      <text:p>268</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>hideout</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>Und warum bist du auf unserer&lt;br&gt;Couch, wenn ich fragen darf?</text:p>
