     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>downhill</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>Bist nur ein regulärer Typ mit einem irregulären Gesicht.</text:p>
