     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>Ich hab gerade ein neues Piece der FRANKS gesehen.</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
    </table:table-row>
    <table:table-row table:style-name="ro2">
     <table:table-cell office:value-type="string" calcext:value-type="string"><text:p><text:span text:style-name="T21">EMAIL_CH4_VINYL</text:span>_02_P2_MSG</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>War weit oben zwischen den Bushalte-stellen.</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
    </table:table-row>
    <table:table-row table:style-name="ro2">
     <table:table-cell office:value-type="string" calcext:value-type="string"><text:p><text:span text:style-name="T21">EMAIL_CH4_VINYL</text:span>_02_P3_MSG</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>Schau mal ob da noch ein FRANK rumhängt.</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
    </table:table-row>
    <table:table-row table:style-name="ro2">
     <table:table-cell table:style-name="ce95" office:value-type="string" calcext:value-type="string">
      <text:p>// Chapter 5</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce39"/>
     <table:table-cell table:number-columns-repeated="2"/>
    </table:table-row>
    <table:table-row table:style-name="ro2">
     <table:table-cell table:style-name="Default" office:value-type="string" calcext:value-type="string">
      <text:p>EMAIL_CH5_COIL_01_SUBJECT</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce98" office:value-type="string" calcext:value-type="string">
      <text:p>Was geht</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
    </table:table-row>
    <table:table-row table:style-name="ro2">
     <table:table-cell office:value-type="string" calcext:value-type="string"><text:p><text:span text:style-name="T21">EMAIL_CH5_COIL</text:span>_01_P1_MSG</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce98" office:value-type="string" calcext:value-type="string">
      <text:p>Ich bin’s, Coil von vorhin</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
    </table:table-row>
    <table:table-row table:style-name="ro2">
     <table:table-cell office:value-type="string" calcext:value-type="string"><text:p><text:span text:style-name="T21">EMAIL_CH5_COIL</text:span>_01_P2_MSG</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce98" office:value-type="string" calcext:value-type="string">
      <text:p>Ich will was testen...</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
    </table:table-row>
    <table:table-row table:style-name="ro2">
     <table:table-cell office:value-type="string" calcext:value-type="string"><text:p><text:span text:style-name="T21">EMAIL_CH5_COIL</text:span>_01_P3_MSG</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce98" office:value-type="string" calcext:value-type="string">
      <text:p>Ich bin *auf&lt;br&gt;der Insel im Mataan Fluss*</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
    </table:table-row>
    <table:table-row table:style-name="ro2">
     <table:table-cell office:value-type="string" calcext:value-type="string"><text:p><text:span text:style-name="T21">EMAIL_CH5_COIL</text:span>_01_P4_MSG</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce98" office:value-type="string" calcext:value-type="string">
      <text:p>Wir sehn&lt;br&gt;uns dort</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
    </table:table-row>
    <table:table-row table:style-name="ro2">
     <table:table-cell table:style-name="Default" office:value-type="string" calcext:value-type="string">
      <text:p>EMAIL_CH5_COIL_02_SUBJECT</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce98" office:value-type="string" calcext:value-type="string">
      <text:p>Mataan chilling</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
    </table:table-row>
    <table:table-row table:style-name="ro2">
     <table:table-cell office:value-type="string" calcext:value-type="string"><text:p><text:span text:style-name="T21">EMAIL_CH5_COIL</text:span>_02_P1_MSG</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce98" office:value-type="string" calcext:value-type="string">
      <text:p>Wie geht’s? Ich bin mal wieder in Mataan</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
    </table:table-row>
    <table:table-row table:style-name="ro2">
     <table:table-cell office:value-type="string" calcext:value-type="string"><text:p><text:span text:style-name="T21">EMAIL_CH5_COIL</text:span>_02_P2_MSG</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce98" office:value-type="string" calcext:value-type="string">
      <text:p>Kennst du *Toy Toy Town*?</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
    </table:table-row>
    <table:table-row table:style-name="ro2">
     <table:table-cell office:value-type="string" calcext:value-type="string"><text:p><text:span text:style-name="T21">EMAIL_CH5_COIL</text:span>_02_P3_MSG</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce98" office:value-type="string" calcext:value-type="string">
      <text:p>Ich bin dort auf dem Dach</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
    </table:table-row>
    <table:table-row table:style-name="ro2">
     <table:table-cell office:value-type="string" calcext:value-type="string"><text:p><text:span text:style-name="T21">EMAIL_CH5_COIL</text:span>_02_P4_MSG</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce98" office:value-type="string" calcext:value-type="string">
      <text:p>In der Nähe der Elefanten</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
    </table:table-row>
    <table:table-row table:style-name="ro2">
     <table:table-cell table:style-name="Default" office:value-type="string" calcext:value-type="string"><text:p><text:span text:style-name="T21">EMAIL_CH5_COIL</text:span>_02_P5_MSG</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce98" office:value-type="string" calcext:value-type="string">
      <text:p>Komm vorbei, ich hab eine Idee</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
    </table:table-row>
    <table:table-row table:style-name="ro2">
     <table:table-cell table:style-name="Default" office:value-type="string" calcext:value-type="string">
      <text:p>EMAIL_CH5_SOLACE_01_SUBJECT</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce98" office:value-type="string" calcext:value-type="string">
      <text:p>Rettung?</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
    </table:table-row>
    <table:table-row table:style-name="ro2">
     <table:table-cell office:value-type="string" calcext:value-type="string"><text:p><text:span text:style-name="T21">EMAIL_CH5__SOLACE_01</text:span>_P1_MSG</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce98" office:value-type="string" calcext:value-type="string">
      <text:p>Ehm... falls du planst mich zu retten...</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
    </table:table-row>
    <table:table-row table:style-name="ro2">
     <table:table-cell office:value-type="string" calcext:value-type="string"><text:p><text:span text:style-name="T21">EMAIL_CH5__SOLACE_01</text:span>_P2_MSG</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce98" office:value-type="string" calcext:value-type="string">
      <text:p>Ich meine, keine Sorge wenn nicht... aber falls...</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
    </table:table-row>
    <table:table-row table:style-name="ro2">
     <table:table-cell office:value-type="string" calcext:value-type="string"><text:p><text:span text:style-name="T21">EMAIL_CH5__SOLACE_01</text:span>_P3_MSG</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>Der große *Löwenmund*...</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
    </table:table-row>
    <table:table-row table:style-name="ro2">
     <table:table-cell office:value-type="string" calcext:value-type="string"><text:p><text:span text:style-name="T21">EMAIL_CH5__SOLACE_01</text:span>_P4_MSG</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>ist ein&lt;br&gt;ziemlich guter,&lt;br&gt;enger Ort ...!</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
    </table:table-row>
    <table:table-row table:style-name="ro2">
     <table:table-cell office:value-type="string" calcext:value-type="string"><text:p><text:span text:style-name="T21">EMAIL_CH5__SOLACE_01</text:span>_P5_MSG</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>Aber&lt;br&gt;auch eine *Abkürzung* hierher...</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
    </table:table-row>
    <table:table-row table:style-name="ro2">
     <table:table-cell office:value-type="string" calcext:value-type="string"><text:p><text:span text:style-name="T21">EMAIL_CH5__SOLACE_01</text:span>_P6_MSG</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>Ehm...&lt;br&gt;nur für den Fall...</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
    </table:table-row>
    <table:table-row table:style-name="ro2">
     <table:table-cell table:style-name="Default" office:value-type="string" calcext:value-type="string">
      <text:p>EMAIL_CH5_BEL_01_SUBJECT</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>Flache Sprünge</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
    </table:table-row>
    <table:table-row table:style-name="ro2">
     <table:table-cell office:value-type="string" calcext:value-type="string"><text:p><text:span text:style-name="T21">EMAIL_CH5_BEL_01</text:span>_P1_MSG</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>Heeey :D, hab dich gerade gesehen</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
    </table:table-row>
    <table:table-row table:style-name="ro2">
     <table:table-cell office:value-type="string" calcext:value-type="string"><text:p><text:span text:style-name="T21">EMAIL_CH5_BEL_01</text:span>_P2_MSG</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>Falls du bei einem Sprung vom Grind schnell bleiben willst...</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
    </table:table-row>
    <table:table-row table:style-name="ro2">
     <table:table-cell office:value-type="string" calcext:value-type="string"><text:p><text:span text:style-name="T21">EMAIL_CH5_BEL_01</text:span>_P3_MSG</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>halten dabei [slide] für einen flachen Sprung gedrückt.</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
    </table:table-row>
    <table:table-row table:style-name="ro2">
     <table:table-cell office:value-type="string" calcext:value-type="string"><text:p><text:span text:style-name="T21">EMAIL_CH5_BEL_01</text:span>_P4_MSG</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>Dadurch kannst du deinen Schwung beibehalten.</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
    </table:table-row>
    <table:table-row table:style-name="ro2">
     <table:table-cell office:value-type="string" calcext:value-type="string"><text:p><text:span text:style-name="T21">EMAIL_CH5_BEL_01</text:span>_P5_MSG</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>Cool oder?</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
    </table:table-row>
    <table:table-row table:style-name="ro2">
     <table:table-cell table:style-name="Default" office:value-type="string" calcext:value-type="string">
      <text:p>EMAIL_CH5_VINYL_01_SUBJECT</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>Flache Sprünge</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
    </table:table-row>
    <table:table-row table:style-name="ro2">
     <table:table-cell office:value-type="string" calcext:value-type="string"><text:p><text:span text:style-name="T21">EMAIL_CH5_VINYL_01</text:span>_P1_MSG</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>Vinyl hier, hab dich gerade vorbeigrinden sehn.</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
    </table:table-row>
    <table:table-row table:style-name="ro2">
     <table:table-cell office:value-type="string" calcext:value-type="string"><text:p><text:span text:style-name="T21">EMAIL_CH5_VINYL_01</text:span>_P2_MSG</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>Falls du bei einem Sprung vom Grind schnell bleiben willst...</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
    </table:table-row>
    <table:table-row table:style-name="ro2">
     <table:table-cell office:value-type="string" calcext:value-type="string"><text:p><text:span text:style-name="T21">EMAIL_CH5_VINYL_01</text:span>_P3_MSG</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>halten dabei [slide] für einen flachen Sprung gedrückt.</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
    </table:table-row>
    <table:table-row table:style-name="ro2">
     <table:table-cell office:value-type="string" calcext:value-type="string"><text:p><text:span text:style-name="T21">EMAIL_CH5_VINYL_01</text:span>_P4_MSG</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>Dadurch kannst du deinen Schwung beibehalten.</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
    </table:table-row>
    <table:table-row table:style-name="ro2">
     <table:table-cell office:value-type="string" calcext:value-type="string"><text:p><text:span text:style-name="T21">EMAIL_CH5_VINYL_01</text:span>_P5_MSG</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
