     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>Mall</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>Der Erste mit einem Graffiti am Ende gewinnt.</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
