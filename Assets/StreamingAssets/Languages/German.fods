     <table:table-cell office:value-type="float" office:value="262" calcext:value-type="float">
      <text:p>262</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>Mall</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>Wow... du hast MICH geschlagen...</text:p>
