     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>O02</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>Werde Teil der&lt;br&gt;Bomb Rush Crew.</text:p>
     </table:table-cell>
     <table:table-cell/>
    </table:table-row>
    <table:table-row table:style-name="ro5">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>O03</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>Hol dir REP mit Graffiti und fordere die Franks für Informationen über&lt;br&gt;DJ Cyber heraus.</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>REP is an ingame mechanic reflected in the UI. Stands for reputation. Preferably untranslated</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="ro2">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>O04</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>Finde einen Weg aufzuwachen.</text:p>
     </table:table-cell>
     <table:table-cell/>
    </table:table-row>
    <table:table-row table:style-name="ro2">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>O05</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string"><text:p><text:span text:style-name="T8">Gehe zum Millennium Square, um dich der </text:span><text:span text:style-name="T12">ECLIPSE</text:span> Crew zu stellen.</text:p>
     </table:table-cell>
     <table:table-cell/>
    </table:table-row>
    <table:table-row table:style-name="ro2">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>O06</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string"><text:p><text:span text:style-name="T8">Hol dir REP und fordere die </text:span><text:span text:style-name="T12">ECLIPSE</text:span> Crew heraus.</text:p>
     </table:table-cell>
     <table:table-cell/>
    </table:table-row>
    <table:table-row table:style-name="ro2">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>O07</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>Beende den Traum.</text:p>
     </table:table-cell>
     <table:table-cell/>
    </table:table-row>
