     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string"><text:p><text:span text:style-name="T8">Wir müssen *Pyramid Island*&lt;br&gt;</text:span>für BOMB RUSH CREW holen.</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
