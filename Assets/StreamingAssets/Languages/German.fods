     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>Die Wahrheit ist: *Ich habe nicht den Kopf, den du suchst...*</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>dj</text:p>
