     </table:table-cell>
     <table:table-cell table:style-name="ce98" office:value-type="string" calcext:value-type="string">
      <text:p>Hast du schon *Boost-Tricks* ausprobiert?&lt;br&gt;Halte [Boost] gedrückt, während du einen Trick machst!</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="3"/>
