     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>Mall</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string"><text:p><text:span text:style-name="T8">*Keine Abkürzungen*! Ich habe Radar,&lt;br&gt;</text:span>also versuch es erst gar nicht.</text:p>
