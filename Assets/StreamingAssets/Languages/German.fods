     <table:table-cell office:value-type="float" office:value="20" calcext:value-type="float">
      <text:p>20</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>Mall</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>Ich bin auch nicht... zu sehr an meinen *aktuellen Boss* gebunden.&lt;br&gt;Seine Sorte *Halsabschneiderei* ist nicht mein Geschäft.</text:p>
