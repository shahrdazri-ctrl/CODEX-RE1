     <table:table-cell office:value-type="float" office:value="207" calcext:value-type="float">
      <text:p>207</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>osaka</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>Okay, das sollte reichen.</text:p>
