     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>Mall</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>Versuche doch, den *ROBO-Post* zu öffnen.&lt;br&gt;Ich habe es extra schwer gemacht!</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="3"/>
