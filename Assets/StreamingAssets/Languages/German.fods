    <table:table-row table:style-name="ro2">
     <table:table-cell office:value-type="float" office:value="202" calcext:value-type="float">
      <text:p>202</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
