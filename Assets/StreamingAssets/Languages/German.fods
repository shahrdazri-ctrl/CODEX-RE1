     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>O08</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string"><text:p><text:span text:style-name="T8">Gehe in die Millennium Mall und besiege die&lt;br&gt;</text:span><text:span text:style-name="T12">DOT EXE</text:span> Crew.</text:p>
     </table:table-cell>
     <table:table-cell/>
    </table:table-row>
