     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>downhill</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string"><text:p><text:span text:style-name="T8">Dieses Bein stammt von einem pu­er­to-ri­ca­nischen Top-Spieler, </text:span><text:span text:style-name="T12">AHAHAHA</text:span>!</text:p>
     </table:table-cell>
