     <table:table-cell table:style-name="ce98" office:value-type="string" calcext:value-type="string"><text:p><text:span text:style-name="T17">Ich bin mir ziemlich sicher, dass FUTURISM&lt;br&gt;</text:span>das aufgestellt hat... denke ich zumindest...</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="3"/>
    </table:table-row>
    <table:table-row table:style-name="ro2">
     <table:table-cell office:value-type="float" office:value="324" calcext:value-type="float">
      <text:p>324</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>osaka</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce98" office:value-type="string" calcext:value-type="string">
      <text:p>...dafür sind wohl die Gasmasken da...</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="3"/>
    </table:table-row>
    <table:table-row table:style-name="ro2">
     <table:table-cell office:value-type="float" office:value="325" calcext:value-type="float">
      <text:p>325</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>osaka</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce98" office:value-type="string" calcext:value-type="string"><text:p><text:span text:style-name="T17">Vielleicht sollten wir... sie bitten, uns&lt;br&gt;</text:span>freundlicherweise durchzulassen...?</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="3"/>
    </table:table-row>
    <table:table-row table:style-name="ro2">
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="Default"/>
     <table:table-cell table:number-columns-repeated="3"/>
    </table:table-row>
    <table:table-row table:style-name="ro2">
     <table:table-cell office:value-type="float" office:value="326" calcext:value-type="float">
      <text:p>326</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>osaka</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce98" office:value-type="string" calcext:value-type="string">
      <text:p>Hey *Felix*!... Ich bin so froh, dass du zurück bist!</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>Solace when talked to with Red</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
    </table:table-row>
    <table:table-row table:style-name="ro2">
     <table:table-cell office:value-type="float" office:value="327" calcext:value-type="float">
      <text:p>327</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>osaka</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce98" office:value-type="string" calcext:value-type="string">
      <text:p>H-h-hast du die fiese Gasbarriere da hinten gesehen?</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="3"/>
    </table:table-row>
    <table:table-row table:style-name="ro2">
     <table:table-cell office:value-type="float" office:value="328" calcext:value-type="float">
      <text:p>328</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>osaka</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce98" office:value-type="string" calcext:value-type="string"><text:p><text:span text:style-name="T17">Ich bin mir ziemlich sicher, dass FUTURISM&lt;br&gt;</text:span>das aufgestellt hat... denke ich zumindest...</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="3"/>
    </table:table-row>
    <table:table-row table:style-name="ro2">
     <table:table-cell office:value-type="float" office:value="329" calcext:value-type="float">
      <text:p>329</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>osaka</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce98" office:value-type="string" calcext:value-type="string"><text:p><text:span text:style-name="T17">Vielleicht sollten wir... sie bitten, uns&lt;br&gt;</text:span>freundlicherweise durchzulassen...?</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="3"/>
    </table:table-row>
    <table:table-row table:style-name="ro2">
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="Default"/>
     <table:table-cell table:number-columns-repeated="3"/>
    </table:table-row>
    <table:table-row table:style-name="ro2">
     <table:table-cell office:value-type="float" office:value="330" calcext:value-type="float">
      <text:p>330</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>osaka</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce98" office:value-type="string" calcext:value-type="string">
      <text:p>Ich dachte, der DJ wollte Felix helfen...</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>solace later on</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
    </table:table-row>
    <table:table-row table:style-name="ro2">
     <table:table-cell office:value-type="float" office:value="331" calcext:value-type="float">
      <text:p>331</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>osaka</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce98" office:value-type="string" calcext:value-type="string">
      <text:p>Warum also macht FUTURISM es uns so schwer?</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="3"/>
    </table:table-row>
    <table:table-row table:style-name="ro2">
     <table:table-cell office:value-type="float" office:value="332" calcext:value-type="float">
      <text:p>332</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>osaka</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce98" office:value-type="string" calcext:value-type="string"><text:p><text:span text:style-name="T17">...Ich verstehe das alles nicht.&lt;br&gt;Warum nicht nett</text:span> zu allen sein?</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="3"/>
    </table:table-row>
    <table:table-row table:style-name="ro2">
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="Default"/>
     <table:table-cell table:number-columns-repeated="3"/>
    </table:table-row>
    <table:table-row table:style-name="ro2">
     <table:table-cell office:value-type="float" office:value="333" calcext:value-type="float">
      <text:p>333</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>osaka</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce98" office:value-type="string" calcext:value-type="string">
      <text:p>Hey Felix...ich dachte, der DJ wollte dir helfen...</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>solace later on when to talked to with red</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
    </table:table-row>
    <table:table-row table:style-name="ro2">
     <table:table-cell office:value-type="float" office:value="334" calcext:value-type="float">
      <text:p>334</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>osaka</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce98" office:value-type="string" calcext:value-type="string">
      <text:p>Warum also macht FUTURISM es uns so schwer?</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="3"/>
    </table:table-row>
    <table:table-row table:style-name="ro2">
     <table:table-cell office:value-type="float" office:value="335" calcext:value-type="float">
      <text:p>335</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>osaka</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce98" office:value-type="string" calcext:value-type="string">
      <text:p>...Ich verstehe das alles nicht.&lt;br&gt;Warum nicht zu allen nett sein?</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="3"/>
    </table:table-row>
    <table:table-row table:style-name="ro2">
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="Default"/>
     <table:table-cell table:number-columns-repeated="3"/>
    </table:table-row>
    <table:table-row table:style-name="ro2">
     <table:table-cell office:value-type="float" office:value="336" calcext:value-type="float">
      <text:p>336</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>osaka</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce98" office:value-type="string" calcext:value-type="string">
      <text:p>Tut mir leid, dass ich euch in die Irre geführt habe...</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>Vinyl</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
    </table:table-row>
    <table:table-row table:style-name="ro2">
     <table:table-cell office:value-type="float" office:value="337" calcext:value-type="float">
      <text:p>337</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>osaka</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce98" office:value-type="string" calcext:value-type="string"><text:p><text:span text:style-name="T17">Aber wir brauchen Felix unbedingt&lt;br&gt;</text:span>zurück, wenn wir Faux aufhalten wollen.</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="3"/>
    </table:table-row>
    <table:table-row table:style-name="ro2">
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="Default"/>
     <table:table-cell table:number-columns-repeated="3"/>
    </table:table-row>
    <table:table-row table:style-name="ro2">
     <table:table-cell office:value-type="float" office:value="338" calcext:value-type="float">
      <text:p>338</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>osaka</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce98" office:value-type="string" calcext:value-type="string">
      <text:p>Hey Felix... oder bevorzugst du noch Red?</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>Vinyl when to talked to with red</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
    </table:table-row>
    <table:table-row table:style-name="ro2">
     <table:table-cell office:value-type="float" office:value="339" calcext:value-type="float">
      <text:p>339</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>osaka</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce98" office:value-type="string" calcext:value-type="string">
      <text:p>Ich hoffe du kannst mir verzeihen,&lt;br&gt;dass ich dich ausgetrickst habe.</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="3"/>
    </table:table-row>
    <table:table-row table:style-name="ro2">
     <table:table-cell office:value-type="float" office:value="340" calcext:value-type="float">
      <text:p>340</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>osaka</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce98" office:value-type="string" calcext:value-type="string">
      <text:p>Aber wir brauchen Felix wirklich zurück.</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="3"/>
    </table:table-row>
    <table:table-row table:style-name="ro2">
     <table:table-cell office:value-type="float" office:value="341" calcext:value-type="float">
      <text:p>341</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>osaka</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce98" office:value-type="string" calcext:value-type="string">
      <text:p>Wir müssen Faux stoppen.</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="3"/>
    </table:table-row>
    <table:table-row table:style-name="ro2">
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="Default"/>
     <table:table-cell table:number-columns-repeated="3"/>
    </table:table-row>
    <table:table-row table:style-name="ro2">
     <table:table-cell office:value-type="float" office:value="342" calcext:value-type="float">
      <text:p>342</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>osaka</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce98" office:value-type="string" calcext:value-type="string">
      <text:p>Red in der Crew zu haben war so nice!</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>bel</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
    </table:table-row>
    <table:table-row table:style-name="ro2">
     <table:table-cell office:value-type="float" office:value="343" calcext:value-type="float">
      <text:p>343</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>osaka</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce98" office:value-type="string" calcext:value-type="string">
      <text:p>Auch wenn Felix eine *Solo*-Legende ist...</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="3"/>
    </table:table-row>
    <table:table-row table:style-name="ro2">
     <table:table-cell office:value-type="float" office:value="344" calcext:value-type="float">
      <text:p>344</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>osaka</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce98" office:value-type="string" calcext:value-type="string"><text:p><text:span text:style-name="T17">Ich glaube, Felix wusste einfach nie, wie&lt;br&gt;</text:span>viel Spaß eine eingespielte Crew macht!</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="3"/>
    </table:table-row>
    <table:table-row table:style-name="ro2">
     <table:table-cell office:value-type="float" office:value="345" calcext:value-type="float">
      <text:p>345</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>osaka</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce98" office:value-type="string" calcext:value-type="string">
      <text:p>Manchmal braucht man einfach eine neue Umgebung, weißt du?</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="3"/>
    </table:table-row>
    <table:table-row table:style-name="ro2">
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="Default"/>
     <table:table-cell table:number-columns-repeated="3"/>
    </table:table-row>
    <table:table-row table:style-name="ro2">
     <table:table-cell office:value-type="float" office:value="346" calcext:value-type="float">
      <text:p>346</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>osaka</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce98" office:value-type="string" calcext:value-type="string">
      <text:p>Hey Red... sollte ich dich ab jetzt Red Felix nennen?</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>bel when talked to with red</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
    </table:table-row>
    <table:table-row table:style-name="ro2">
     <table:table-cell office:value-type="float" office:value="347" calcext:value-type="float">
      <text:p>347</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>osaka</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce98" office:value-type="string" calcext:value-type="string">
      <text:p>Red Felix ist aber so lang! Wie wär’s mit *Reflex*?!</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>Reflex preferably untranslated</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
    </table:table-row>
    <table:table-row table:style-name="ro2">
     <table:table-cell office:value-type="float" office:value="348" calcext:value-type="float">
      <text:p>348</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>osaka</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce98" office:value-type="string" calcext:value-type="string">
      <text:p>Okay cool... ich wusste, dass Red gut klingt!</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="3"/>
    </table:table-row>
    <table:table-row table:style-name="ro2">
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce39"/>
     <table:table-cell table:number-columns-repeated="3"/>
    </table:table-row>
    <table:table-row table:style-name="ro2">
     <table:table-cell office:value-type="float" office:value="55" calcext:value-type="float">
      <text:p>55</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>osaka</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>Geh weiter, Trottel.</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>futurism guard blocking the way</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
    </table:table-row>
    <table:table-row table:style-name="ro2">
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce39"/>
     <table:table-cell table:number-columns-repeated="3"/>
    </table:table-row>
    <table:table-row table:style-name="ro2">
     <table:table-cell office:value-type="float" office:value="56" calcext:value-type="float">
      <text:p>56</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>osaka</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>Zeit für einen strategischen Rückzug.</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>futurism when police shows up</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
    </table:table-row>
    <table:table-row table:style-name="ro2">
     <table:table-cell office:value-type="float" office:value="57" calcext:value-type="float">
      <text:p>57</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>osaka</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>Sucht uns erst gar nicht,&lt;br&gt;wenn ihr Trottel nicht mal *180 REP* habt.</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="3"/>
    </table:table-row>
    <table:table-row table:style-name="ro2">
