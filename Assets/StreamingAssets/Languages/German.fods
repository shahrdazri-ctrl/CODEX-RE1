     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>downhill</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>Was unterbrichst du meinen Kombo?</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>when talking to 1 of the FRANKS without having enough reputation</text:p>
     </table:table-cell>
