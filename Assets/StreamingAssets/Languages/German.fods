      <text:p>pyramid</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string"><text:p><text:span text:style-name="T8">Sie haben uns reingelegt, Red, Vinyl&lt;br&gt;</text:span>war in die ganze Sache verwickelt.</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
