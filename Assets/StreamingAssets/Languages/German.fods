     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>hideout</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>Ich kann es nicht erklären, aber... All City.&lt;br&gt;Es fühlt sich richtig an.</text:p>
     </table:table-cell>
