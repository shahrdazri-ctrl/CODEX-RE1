     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>osaka</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>Ich glaube, ich weiß, in welche Richtung sie gehen...</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
