     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>Hmmmhh definitiv *155 REP*, nicht weniger.</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="3"/>
    </table:table-row>
    <table:table-row table:style-name="ro2">
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce39"/>
     <table:table-cell table:number-columns-repeated="3"/>
    </table:table-row>
    <table:table-row table:style-name="ro2">
     <table:table-cell office:value-type="float" office:value="264" calcext:value-type="float">
      <text:p>264</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>osaka</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>Sieh an, sieh an. Du hast dir etwas REP besorgt...!</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>oldhead enough rep</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
    </table:table-row>
    <table:table-row table:style-name="ro2">
     <table:table-cell office:value-type="float" office:value="265" calcext:value-type="float">
      <text:p>265</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>osaka</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>Weißt du, ich war früher König von Mataan.&lt;br&gt;Von Anfang an dabei!</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="3"/>
    </table:table-row>
    <table:table-row table:style-name="ro2">
     <table:table-cell office:value-type="float" office:value="266" calcext:value-type="float">
      <text:p>266</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>osaka</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>Hmmm... Es gab etwa fünf Gebäude in der ganzen Gegend,&lt;br&gt;aber auf allen war mein Name!</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="3"/>
    </table:table-row>
    <table:table-row table:style-name="ro2">
     <table:table-cell office:value-type="float" office:value="267" calcext:value-type="float">
      <text:p>267</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>osaka</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>Davor habe ich in *Old Amsterdam* gelebt.&lt;br&gt;Hier ist nicht dasselbe, sag ich dir.</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="3"/>
    </table:table-row>
    <table:table-row table:style-name="ro2">
     <table:table-cell office:value-type="float" office:value="268" calcext:value-type="float">
      <text:p>268</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>osaka</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>Weißt du überhaupt, was ein *Baum* ist, Kind?&lt;br&gt;Wir hatten viele davon!</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="3"/>
    </table:table-row>
    <table:table-row table:style-name="ro2">
     <table:table-cell office:value-type="float" office:value="269" calcext:value-type="float">
      <text:p>269</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>osaka</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string"><text:p><text:span text:style-name="T8">Ich spreche hier von echten, *natürlich&lt;br&gt;</text:span>wachsenden Sauerstoffspendern*!</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="3"/>
    </table:table-row>
    <table:table-row table:style-name="ro2">
     <table:table-cell office:value-type="float" office:value="270" calcext:value-type="float">
      <text:p>270</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>osaka</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>Wenn du mich fragst, sollten sie einige davon zurückbringen.</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="3"/>
    </table:table-row>
    <table:table-row table:style-name="ro2">
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce39"/>
     <table:table-cell table:number-columns-repeated="3"/>
    </table:table-row>
    <table:table-row table:style-name="ro2">
     <table:table-cell office:value-type="float" office:value="271" calcext:value-type="float">
      <text:p>271</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>osaka</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>...Eh? Was ich hier mache?</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>oldhead not enough rep</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
    </table:table-row>
    <table:table-row table:style-name="ro2">
     <table:table-cell office:value-type="float" office:value="272" calcext:value-type="float">
      <text:p>272</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>osaka</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string"><text:p><text:span text:style-name="T8">Ne gute Zeit haben, ich war schon&lt;br&gt;</text:span>immer der Mittelpunkt der Party!</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="3"/>
    </table:table-row>
    <table:table-row table:style-name="ro2">
     <table:table-cell office:value-type="float" office:value="273" calcext:value-type="float">
      <text:p>273</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>osaka</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>Auf den Partys meiner Zeit ließen sie dich nicht ohne REP rein...</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="3"/>
    </table:table-row>
    <table:table-row table:style-name="ro2">
     <table:table-cell office:value-type="float" office:value="274" calcext:value-type="float">
      <text:p>274</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>osaka</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>Mindestens *155 REP*!</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="3"/>
    </table:table-row>
    <table:table-row table:style-name="ro2">
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce39"/>
     <table:table-cell table:number-columns-repeated="3"/>
    </table:table-row>
    <table:table-row table:style-name="ro2">
     <table:table-cell office:value-type="float" office:value="275" calcext:value-type="float">
      <text:p>275</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>osaka</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>Hast also dein Bestes gegeben und dir hier eine Ruf verdient!</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>oldhead enough rep</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
    </table:table-row>
    <table:table-row table:style-name="ro2">
     <table:table-cell office:value-type="float" office:value="276" calcext:value-type="float">
      <text:p>276</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>osaka</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>Deiner Generation geht’s gut,&lt;br&gt;muss ich sagen. Ich hänge nur herum...</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="3"/>
    </table:table-row>
    <table:table-row table:style-name="ro2">
     <table:table-cell office:value-type="float" office:value="277" calcext:value-type="float">
      <text:p>277</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>osaka</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>Ich mag die Abgründe von Mataan,&lt;br&gt;erinnert mich an die alten Kanäle.</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="3"/>
    </table:table-row>
    <table:table-row table:style-name="ro2">
     <table:table-cell office:value-type="float" office:value="278" calcext:value-type="float">
      <text:p>278</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>osaka</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>Und die Straße hinter mir.&lt;br&gt;Ist nostalgisch.</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="3"/>
    </table:table-row>
    <table:table-row table:style-name="ro2">
     <table:table-cell office:value-type="float" office:value="279" calcext:value-type="float">
      <text:p>279</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>osaka</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>Wir hatten früher in der *alten Stadt* auch so ein Viertel.</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="3"/>
    </table:table-row>
    <table:table-row table:style-name="ro2">
     <table:table-cell office:value-type="float" office:value="280" calcext:value-type="float">
      <text:p>280</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>osaka</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>Ahhhhh...... Ja... die See,&lt;br&gt;sie kennt unsere Gedanken und Sorgen nicht.</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="3"/>
    </table:table-row>
    <table:table-row table:style-name="ro2">
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="Default"/>
     <table:table-cell table:number-columns-repeated="3"/>
    </table:table-row>
    <table:table-row table:style-name="ro2">
     <table:table-cell office:value-type="float" office:value="440" calcext:value-type="float">
      <text:p>440</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>hideout</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce98" office:value-type="string" calcext:value-type="string">
      <text:p>Auf *Skateboard* wechseln?</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>in the hideout for switching movestyle, also takes you to the menu to switch colors on your skateboard/skates/bmx</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
    </table:table-row>
    <table:table-row table:style-name="ro2">
     <table:table-cell office:value-type="float" office:value="441" calcext:value-type="float">
      <text:p>441</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>hideout</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce98" office:value-type="string" calcext:value-type="string">
      <text:p>Auf *Inlines* wechseln?</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="3"/>
    </table:table-row>
    <table:table-row table:style-name="ro2">
     <table:table-cell office:value-type="float" office:value="442" calcext:value-type="float">
      <text:p>442</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>hideout</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce98" office:value-type="string" calcext:value-type="string">
      <text:p>Auf *BMX* wechseln?</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="3"/>
    </table:table-row>
    <table:table-row table:style-name="ro2">
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="Default"/>
     <table:table-cell table:style-name="ce95" office:value-type="string" calcext:value-type="string">
      <text:p>take a taxi, spoken by Benni, the taxi driver. can be in any stage</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
    </table:table-row>
    <table:table-row table:style-name="ro2">
     <table:table-cell office:value-type="float" office:value="443" calcext:value-type="float">
      <text:p>443</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>hideout</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce98" office:value-type="string" calcext:value-type="string">
      <text:p>Coole Moves! Musst du irgendwo hin?</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>When the taxi shows up after you’ve danced at a sign</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
    </table:table-row>
    <table:table-row table:style-name="ro2">
     <table:table-cell office:value-type="float" office:value="444" calcext:value-type="float">
      <text:p>444</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>hideout</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce98" office:value-type="string" calcext:value-type="string">
      <text:p>Geht klar.</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>when you’ve chosen a destination and you leave in the taxi</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
    </table:table-row>
    <table:table-row table:style-name="ro2">
     <table:table-cell office:value-type="float" office:value="445" calcext:value-type="float">
      <text:p>445</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>hideout</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce98" office:value-type="string" calcext:value-type="string">
      <text:p>Da wären wir. Bis zum nächsten Mal!</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>when you’ve arrived at your destination with the taxi</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
    </table:table-row>
    <table:table-row table:style-name="ro2">
     <table:table-cell office:value-type="float" office:value="446" calcext:value-type="float">
      <text:p>446</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>hideout</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce98" office:value-type="string" calcext:value-type="string">
      <text:p>Alles klar, kein Problem. Wir sehen uns!</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>when you choose to cancel the taxi ride before chosing</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
    </table:table-row>
    <table:table-row table:style-name="ro2">
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="Default"/>
     <table:table-cell table:style-name="ce95" office:value-type="string" calcext:value-type="string">
      <text:p>when interacting with the taxi sign (no speaking character)</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
    </table:table-row>
    <table:table-row table:style-name="ro2">
     <table:table-cell office:value-type="float" office:value="447" calcext:value-type="float">
      <text:p>447</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>hideout</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce98" office:value-type="string" calcext:value-type="string">
      <text:p>Sieht aus als könnte man hier *mit einem Taxi fahren*.</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="3"/>
    </table:table-row>
    <table:table-row table:style-name="ro2">
     <table:table-cell office:value-type="float" office:value="448" calcext:value-type="float">
      <text:p>448</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>hideout</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce98" office:value-type="string" calcext:value-type="string"><text:p><text:span text:style-name="T17">Wenn du mit einem *Taxi* fährst, kannst&lt;br&gt;</text:span>du jetzt diese Gegend als *Ziel* wählen.</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="3"/>
    </table:table-row>
    <table:table-row table:style-name="ro2">
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="Default"/>
     <table:table-cell table:number-columns-repeated="3"/>
    </table:table-row>
    <table:table-row table:style-name="ro2">
     <table:table-cell office:value-type="float" office:value="449" calcext:value-type="float">
      <text:p>449</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>hideout</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce98" office:value-type="string" calcext:value-type="string">
      <text:p>Hier kannst du auf *BMX* wechseln&lt;br&gt;oder dein BMX *ändern*.</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>shown when the BMX garage door opens</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
    </table:table-row>
    <table:table-row table:style-name="ro2">
     <table:table-cell office:value-type="float" office:value="450" calcext:value-type="float">
      <text:p>450</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>hideout</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce98" office:value-type="string" calcext:value-type="string">
      <text:p>Hier kannst du auf *Inlines* wechseln&lt;br&gt;oder deine Inlines *ändern*.</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>shown when the skates garage door opens</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
    </table:table-row>
    <table:table-row table:style-name="ro2">
     <table:table-cell office:value-type="float" office:value="451" calcext:value-type="float">
      <text:p>451</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>hideout</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce98" office:value-type="string" calcext:value-type="string">
      <text:p>Hier kannst du auf *Skateboard* wechseln&lt;br&gt;oder dein Skateboard *ändern*.</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
