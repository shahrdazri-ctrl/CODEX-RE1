     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>O16</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>Finde den Flesh Prince&lt;br&gt;in Versum Hill.</text:p>
