     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>osaka</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>Keine Zeit zu verlieren.</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
