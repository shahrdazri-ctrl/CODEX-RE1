     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>Mall</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>*Wenn BRC All City wird*, hat DJ Cyber wirklich *ein Problem*.</text:p>
     </table:table-cell>
